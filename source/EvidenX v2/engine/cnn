def load_model():
    global model
    try:
        model = Meso4().to(device)
        weights_path = "mesonet_weights.pth" # Look for this file
        
        if os.path.exists(weights_path):
            try:
                model.load_state_dict(torch.load(weights_path, map_location=device))
                model.eval()
                print("MesoNet Model loaded with REAL weights.")
            except Exception as e:
   print(f"Error loading weights file: {e}. Model initialized with random weights (NOT SUITABLE FOR PRODUCTION).")
